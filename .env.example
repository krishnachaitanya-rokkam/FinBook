# VITE_AI_API_URL: Public HTTPS endpoint of the Cloudflare Worker used by AHVIQ AI.
# Do not put the Gemini API key in any VITE_* variable.
VITE_AI_API_URL="https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev"

# Gemini is stored as a Cloudflare Worker secret, not in the frontend.
GEMINI_API_KEY="SERVER_SIDE_ONLY"
GEMINI_MODEL="gemini-2.5-flash-lite"

# APP_URL: The URL where this app is hosted.
APP_URL="https://krishnachaitanya-rokkam.github.io/FinBook/"

# Legacy Supabase placeholders retained for existing project tooling.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
