rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isFamilyMember(familyId) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(familyId)) && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberIds;
    }
    function isFamilyOwner(familyId) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(familyId)) && get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid;
    }
    function isValidFamilyJoin(familyId) {
      let code = request.resource.data.get('acceptedInviteCode', '');
      let invitePath = /databases/$(database)/documents/familyInvites/$(code);
      return signedIn() && code != '' && exists(invitePath) && get(invitePath).data.familyId == familyId && get(invitePath).data.status == 'accepted' && get(invitePath).data.acceptedBy == request.auth.uid && get(invitePath).data.inviteeEmail == request.auth.token.email && request.auth.uid in request.resource.data.memberIds && !(request.auth.uid in resource.data.memberIds) && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'acceptedInviteCode']);
    }
    function isValidFamilyLeave(familyId) {
      return isFamilyMember(familyId) && request.auth.uid in resource.data.memberIds && !(request.auth.uid in request.resource.data.memberIds) && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members']);
    }
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /families/{familyId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.memberIds.hasOnly([request.auth.uid]) && request.resource.data.memberIds.size() == 1;
      allow read: if isFamilyMember(familyId);
      allow update: if isFamilyOwner(familyId) || isValidFamilyJoin(familyId) || isValidFamilyLeave(familyId);
      allow delete: if isFamilyOwner(familyId);
    }
    match /families/{familyId}/summaries/{memberId} {
      allow read: if isFamilyMember(familyId);
      allow create, update: if isFamilyMember(familyId) && request.auth.uid == memberId;
      allow delete: if isFamilyMember(familyId) && request.auth.uid == memberId;
    }
    match /familyInvites/{inviteId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.inviteeEmail == request.auth.token.email);
      allow update: if signedIn() && resource.data.status == 'pending' && resource.data.inviteeEmail == request.auth.token.email && request.resource.data.status == 'accepted' && request.resource.data.acceptedBy == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
